# GnuCash Web - Environment Variables
# Copy to backend/.env and fill in real values

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://gnucash:gnucash@localhost:5432/gnucash_web

# Redis (Celery broker & result backend)
REDIS_URL=redis://192.168.1.166:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-string-256-bit-minimum

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 (receipt attachments)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=gnucash-receipts
CLOUDFLARE_R2_ENDPOINT=

# Email (Postmark)
POSTMARK_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com

# Celery
CELERY_BROKER_URL=redis://192.168.1.166:6379/0
CELERY_RESULT_BACKEND=redis://192.168.1.166:6379/1
