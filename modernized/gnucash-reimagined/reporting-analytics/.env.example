# Reporting & Analytics — environment configuration
# Copy to .env and fill in per-environment values.
# NO credential literal is committed to source control.

DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Tenant context — set by TenantContextMiddleware per request.
# For local development, fall back to a fixed tenant slug.
DEFAULT_TENANT_SLUG=fva-sandbox

# LLM provider — used by the AI explainer. One of:
#   openai | anthropic | stub
LLM_PROVIDER=stub
LLM_API_KEY=${LLM_API_KEY}
LLM_MODEL=${LLM_MODEL}

# Object storage (report artifacts / exported CSVs / PDF)
OBJECT_STORAGE_ENDPOINT=${OBJECT_STORAGE_ENDPOINT}
OBJECT_STORAGE_BUCKET=${OBJECT_STORAGE_BUCKET}
OBJECT_STORAGE_ACCESS_KEY=${OBJECT_STORAGE_ACCESS_KEY}
OBJECT_STORAGE_SECRET_KEY=${OBJECT_STORAGE_SECRET_KEY}

# Accounting Engine — URL of the ledger service this context reads from.
ACCOUNTING_ENGINE_URL=http://localhost:8000
# Path of the golden-tests manifest used by the dependency gate.
ACCOUNTING_ENGINE_GOLDEN_MANIFEST=../accounting-engine/manifests/golden.lock

DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
DJANGO_DEBUG=true
