# Document Intelligence environment configuration
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Django
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=

# Database
DB_NAME=fva
DB_USER=fva_app
DB_PASSWORD=${DB_PASSWORD}
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible)
DOC_STORAGE_BUCKET=${DOC_STORAGE_BUCKET}
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
# Set S3_ENDPOINT_URL for MinIO in dev
S3_ENDPOINT_URL=

# OCR Provider
OCR_PROVIDER=aws_textract  # aws_textract | google_document_ai | mock
OCR_CONFIDENCE_THRESHOLD=0.75

# AI Suggestions
AI_SUGGESTIONS_ENABLED=true
LLM_PROVIDER=openai  # openai | anthropic
AI_CONFIDENCE_THRESHOLD=0.80
OPENAI_API_KEY=${OPENAI_API_KEY}
# ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# Duplicate Detection
DUPLICATE_INVOICE_WINDOW_DAYS=90
