# Django
DJANGO_SECRET_KEY=your-secret-key-at-least-256-bits
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database
DATABASE_URL=postgresql://gnucash_user:gnucash_pass@postgres-host:5432/gnucash_web

# Redis
REDIS_URL=redis://redis-host:6379/0

# Celery
CELERY_BROKER_URL=redis://redis-host:6379/0
CELERY_RESULT_BACKEND=redis://redis-host:6379/1

# JWT
JWT_SECRET_KEY=your-jwt-secret-at-least-256-bits

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email (Postmark)
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true

# Cloudflare R2 (for receipt attachments)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=gnucash-receipts
